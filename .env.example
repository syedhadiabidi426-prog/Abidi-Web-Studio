# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server Port
PORT=3000

# Admin Authentication
# Set your secure administrative password here. If left unset, a default development secret is used.
ADMIN_PASSWORD="ChangeThisToAStrongPassword2026!"
SESSION_SECRET="abidi-web-studio-session-secret-key-change-in-production"

# Email Delivery Configuration (Optional - for server-side SMTP lead dispatch)
# If left empty, enquiries are safely stored in the database / data storage layer with full audit log
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"
NOTIFICATION_EMAIL="syedhadiabidi426@gmail.com"
